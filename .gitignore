# Dépendances
node_modules/

# Variables d'environnement
.env
.env.*
!.env.example

# Builds
dist/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Uploads / fichiers temporaires
uploads/
tmp/
temp/

# Sauvegardes PostgreSQL locales (backup-postgres.sh) — uploadées vers
# Google Drive, jamais versionnées
backups/

# OS
.DS_Store
Thumbs.db

# IDE / éditeurs
.vscode/
.idea/
*.swp

# Coverage / tests
coverage/

# Cache
.cache/
.eslintcache

# Certificats & clés
*.pem
*.key
*.crt

# Sequelize
*.sqlite

# Clé de compte de service Firebase (secret) : en production, passer par
# FIREBASE_SERVICE_ACCOUNT_JSON dans .env ; ce fichier local ne doit jamais
# être versionné ni embarqué dans l'image.
src/config/firebase-service-account.json

# Base PostgreSQL jetable des tests d'intégration locaux (npm run test:integration:local)
.tmp-pg/

# État des déploiements sur le serveur (deploy/release.sh)
.deploy/
